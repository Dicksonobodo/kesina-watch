rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read and write their own data (profile, pinned sites, stats).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Games: all scoring, answers and leaderboards are written by the server (the /api/games
    // function uses admin credentials, which bypass these rules). Browsers may only WATCH the
    // battle room they are in; they can never write it, and the answers live in rooms_secret,
    // which no browser can read.
    match /rooms/{code} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }
  }
}

PORT=8787
# Sites allowed to call this server, comma-separated. * matches one name part,
# e.g. https://dixon-watch-*.vercel.app for Vercel preview deployments.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Your Firebase project id (used to verify that callers are signed in)
FIREBASE_PROJECT_ID=mywatch-eccf4
# Set to false only for local testing without signing in
REQUIRE_AUTH=true
# Optional: full path to Chrome/Chromium/Edge. Auto-detected if empty.
CHROME_PATH=
# Detections per user per 10 minutes
RATE_LIMIT=30
# Public https address of this server once deployed (e.g. https://api.yourdomain.com)
PUBLIC_URL=
# Keep a fixed secret in production so download/stream links survive restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_SECRET=
# Capacity: headless pages at once, relay streams per user and in total
BROWSER_SLOTS=2
RELAY_PER_USER=8
RELAY_TOTAL=200
# Who can open the admin dashboard (comma-separated sign-in emails)
ADMIN_EMAILS=
# Premium (Paystack). Needs both keys below; leave empty to keep Premium switched off.
PAYSTACK_SECRET_KEY=
# Firebase → Project settings → Service accounts → Generate new private key; paste the JSON on one line
FIREBASE_SERVICE_ACCOUNT=
PREMIUM_PRICE_KOBO=150000
PREMIUM_DAYS=30
